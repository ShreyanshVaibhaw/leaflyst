# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://localhost:5432/leaflyst
APP_URL=http://localhost:3000
# 32 bytes as base64, for encrypting Google refresh tokens and preview secrets: openssl rand -base64 32
ENCRYPTION_KEY=
SESSION_SECRET=
# Lets you sign in without GitHub. Only works when APP_URL is on localhost.
DEV_LOGIN=true

# GitHub App (Settings > Developer settings > GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Google OAuth client (Search Console and Analytics, read-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DataForSEO
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Anthropic. Agent and environment IDs come from: pnpm tsx agents/fix-agent/setup.ts
ANTHROPIC_API_KEY=
FIX_AGENT_ID=
FIX_ENVIRONMENT_ID=
