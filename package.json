{
  "name": "leaflyst",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "worker": "tsx --env-file-if-exists=.env src/worker/main.ts",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c tests/playwright.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate.ts",
    "fixture:dev": "pnpm --filter demo-site dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "papaparse": "^5.7.1",
    "pg-boss": "^12.39.0",
    "playwright": "^1.65.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  }
}
